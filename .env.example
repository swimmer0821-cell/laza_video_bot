# Токен бота от @BotFather
BOT_TOKEN=
# Ключ fal.ai (fal.ai → API Keys)
FAL_KEY=
# Ключ Claude (тот же, что у бота продаж)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5
# Руководители: могут давать доступ (/add) и менять эталоны персонажа
ADMIN_IDS=   # ваш Telegram id (узнать: написать боту @userinfobot)
# Кто ещё может пользоваться ботом (через запятую). Можно добавлять и командой /add в боте
ALLOWED_IDS=
# Лимит трат на всех за сутки, $
DAILY_LIMIT_USD=20
# Узбекская озвучка без акцента (Microsoft Azure Speech, бесплатно до 500 000 символов в месяц)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Живые голоса Google (Gemini TTS): ключ из https://aistudio.google.com/apikey
GEMINI_API_KEY=
